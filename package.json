{
  "name": "receipthero-monorepo",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@types/node": "^22.10.2",
      "@types/react": "^19.2.0",
      "@types/react-dom": "^19.2.0",
      "@upstash/ratelimit": "^2.0.8",
      "@upstash/redis": "^1.36.1",
      "@vitejs/plugin-react": "^5.0.4",
      "class-variance-authority": "^0.7.1",
      "clsx": "^2.1.1",
      "hono": "^4.7.11",
      "react": "19.2.0",
      "react-dom": "19.2.0",
      "tailwind-merge": "^3.4.0",
      "tailwindcss": "^4.0.6",
      "together-ai": "^0.22.0",
      "tw-animate-css": "^1.4.0",
      "typescript": "^5.7.2",
      "vite": "7.3.1",
      "zod": "^4.1.5"
    }
  },
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "turbo run dev",
    "start": "turbo run start",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deps:reset": "pnpx npkill -D -y",
    "db:nuke": "rm -rf ./receipthero.db && rm -rf ./packages/core/drizzle",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix",
    "*.{ts,tsx,js,jsx,json,md,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "eslint": "^9.39.2",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "prettier": "^3.5.3",
    "turbo": "^2.8.1",
    "typescript-eslint": "^8.54.0"
  }
}
